RACING_DB_PATH=data/racing.db
RACING_CODEX_CLI=codex
RACING_CODEX_MODEL=gpt-5.5
RACING_CODEX_REASONING_EFFORT=high
RACING_CODEX_TIMEOUT_SECONDS=180
RACING_ODDS_PROVIDER=auto
RACING_USER_AGENT=RacingModelResearchBot/0.1
RACING_REQUEST_DELAY_SECONDS=2.0

# PostgreSQL is provisioned for server readiness. The current app still uses
# SQLite through RACING_DB_PATH until the DB adapter is upgraded.
POSTGRES_PASSWORD=change-me-before-deploy
